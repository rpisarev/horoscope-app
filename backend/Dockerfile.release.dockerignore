# Build with context ./backend. Only runtime code and migration inputs may enter.
**
!requirements.txt
!wsgi.py
!paid_execution_policy.py
!paid_admission_policy.py
!alembic.ini
!app/**/*.py
!migrations/**/*.py
!migrations/script.py.mako
!utils/*.py

# Deny these at every depth, even below an allowed source directory.
**/.env
**/.env.*
**/*.env
**/.git
**/.git/**
**/.npmrc
**/.pypirc
**/pip.conf
**/secrets
**/secrets/**
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/tests
**/tests/**
**/test_*.py
**/*_test.py
**/safety_tests
**/safety_tests/**
**/artifacts
**/artifacts/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.pytest_cache
**/.pytest_cache/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/instance
**/instance/**
