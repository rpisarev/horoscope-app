FROM node:24-alpine AS build

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY index.html vite.config.js tsconfig.json postcss.config.cjs tailwind.config.cjs ./
COPY src ./src
RUN npm run build

FROM caddy:2.11.9-alpine AS runtime

WORKDIR /srv
COPY --from=build /build/dist/ /srv/
COPY Caddyfile.release /etc/caddy/Caddyfile
COPY caddy-entrypoint.sh /etc/demo/caddy-entrypoint.sh

# Integration mounts its routing/TLS configuration at this same path.
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
