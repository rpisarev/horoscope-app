{
  "name": "horoscope-frontend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "poc:serve": "node poc/server.mjs",
    "poc:check": "node --test poc/checks.mjs",
    "poc:verify": "node poc/verify.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.11",
    "lucide-vue-next": "0.511.0",
    "swiper": "12.2.0",
    "vue": "^3.5.45",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.1",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.17",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "vue-tsc": "3.3.11"
  }
}
