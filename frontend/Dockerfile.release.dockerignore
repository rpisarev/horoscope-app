# Build with context ./frontend. Exclude everything, then allow build inputs.
**
!package.json
!package-lock.json
!index.html
!vite.config.js
!tsconfig.json
!postcss.config.cjs
!tailwind.config.cjs
!Caddyfile.release
!src/**/*.vue
!src/**/*.js
!src/**/*.ts
!src/**/*.css
!src/assets/**/*.png

# Deny these at every depth, even below an allowed source directory.
**/.env
**/.env.*
**/*.env
**/.git
**/.git/**
**/.npmrc
**/.pypirc
**/secrets
**/secrets/**
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/tests
**/tests/**
**/__tests__
**/__tests__/**
**/*.test.*
**/*.spec.*
**/artifacts
**/artifacts/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/coverage
**/coverage/**
