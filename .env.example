# Non-secret local development settings.
# Copy to .env only if you want to override defaults used by docker-compose.yml.

APP_TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# Scheduler time for legacy nightly generation.
SCHEDULE_HOUR=1
SCHEDULE_MINUTE=0

# Set to 1 if you want scheduler to generate forecasts immediately on container start.
RUN_NIGHTLY_ON_START=0

# Legacy retry-missing scheduler for current APP_TIMEZONE date.
RETRY_MISSING_ENABLED=1
RETRY_INTERVAL_MINUTES=30
RETRY_WINDOW_START_HOUR=1
RETRY_WINDOW_END_HOUR=6
MAX_RETRY_RUNS_PER_DAY=3

# Horoscope generation provider.
# Keep "stub" for local development without paid API calls.
HOROSCOPE_PROVIDER=stub

# Generation lifecycle defaults.
GENERATION_MAX_ATTEMPTS=3
GENERATION_STALE_HOURS=2

# Queued generation jobs worker.
# Disabled by default. Enable only when you want the scheduler container
# to poll generation_jobs and execute queued jobs.
GENERATION_JOB_WORKER_ENABLED=0
GENERATION_JOB_WORKER_INTERVAL_SECONDS=60
GENERATION_JOB_WORKER_MAX_JOBS_PER_TICK=1
GENERATION_JOB_WORKER_ALLOW_OPENAI=0
GENERATION_JOB_STALE_AFTER_MINUTES=60
GENERATION_JOB_WORKER_ID=scheduler

# To enable real OpenAI generation:
# HOROSCOPE_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_OUTPUT_TOKENS=500

# Admin API.
# Keep disabled by default.
ADMIN_API_ENABLED=0
ADMIN_API_TOKEN=change-me-local-admin-token
ADMIN_API_ALLOW_OPENAI=0

# Optional explicit database URL override.
# DATABASE_URL=postgresql://user:pass@db:5432/horoscope