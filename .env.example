# Non-secret local development settings.
# Copy to .env only if you want to override defaults used by docker-compose.yml.

APP_TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# Scheduler time for nightly generation.
SCHEDULE_HOUR=1
SCHEDULE_MINUTE=0

# Set to 1 if you want scheduler to generate forecasts immediately on container start.
RUN_NIGHTLY_ON_START=0

# Future LLM integration.
# OPENAI_API_KEY=your_openai_api_key_here
# DATABASE_URL=postgresql://user:pass@db:5432/horoscope

